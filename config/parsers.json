{
  "_description": "Инфраструктурные параметры форматных парсеров. Не относятся к конкретным типам документов — здесь живут только URLs сервисов, модели и алгоритмические настройки. doc_configs/<тип>/config.json описывает ЧТО парсить, этот файл — КАК.",
  "pdf": {
    "layout": {
      "base_url": "http://172.16.10.35:11439",
      "timeout": 60,
      "model": "docling-project/docling-layout-heron-101",
      "device": "cuda:0",
      "conf_threshold": 0.3,
      "post_conf_min": 0.1,
      "dedup_iou": 0.9,
      "containment_thr": 0.7
    },
    "vlm": {
      "base_url": "http://localhost:8010/v1/",
      "model": null,
      "api_key": "none",
      "max_tokens": 2000,
      "temperature": 0.0
    },
    "parsing": {
      "table_output_format": "html",
      "class_prompts": {
        "Text": "OCR:",
        "Title": "OCR:",
        "Section-header": "OCR:",
        "Caption": "OCR:",
        "Footnote": "OCR:",
        "List-item": "OCR:",
        "Page-header": "OCR:",
        "Page-footer": "OCR:",
        "Document Index": "OCR:",
        "Code": "OCR:",
        "Form": "OCR:",
        "Key-Value Region": "OCR:",
        "Checkbox-Selected": "OCR:",
        "Checkbox-Unselected": "OCR:",
        "Table": "Table Recognition:",
        "Formula": "Formula Recognition:",
        "Picture": "OCR:"
      },
      "class_md_wrapper": {
        "Text": "{text}",
        "Title": "## {text}",
        "Section-header": "### {text}",
        "Caption": "*{text}*",
        "Footnote": "*{text}*",
        "List-item": "{text}",
        "Page-header": "{text}",
        "Page-footer": "{text}",
        "Document Index": "{text}",
        "Code": "```\n{text}\n```",
        "Form": "{text}",
        "Key-Value Region": "{text}",
        "Checkbox-Selected": "[x] {text}",
        "Checkbox-Unselected": "[ ] {text}",
        "Table": "{text}",
        "Formula": "$$\n{text}\n$$",
        "Picture": "{text}"
      }
    },
    "extractor": {
      "max_page_pixels": 4000,
      "blank_page_white_threshold": 0.995,
      "blank_page_detect_dpi": 72,
      "small_element_min_area_ratio": 0.001,
      "small_element_classes": ["Page-header", "Page-footer"],
      "table_mask_padding_px": 5,
      "crop_padding_px": 15
    },
    "dpi": 200
  }
}
