    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "# 1. Загружаем ранее подготовленный JSON с распарсенными блоками\n",
    "parsed_path = Path(\"parsed.json\")  # или путь, куда вы сохранили результат parse_driver.py\n",
    "data = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "# 2. Обходим все секции, собираем ответы LLM\n",
    "section_results = []\n",
    "for section in data[\"sections\"]:\n",
    "    payload = prepare_section_context(section)\n",
    "    answer_text, _ = call_driver_llm(client, payload)  # можно сериализовать _ при необходимости\n",
    "    section_json = json.loads(answer_text)\n",
    "    section_results.append(section_json)\n",
    "\n",
    "\n",
    "# 3. Агрегируем замечания и карту выводов\n",
    "remarks, driver_summary_map = collect_remarks_and_summaries(section_results)\n",
    "\n",
    "# Сохраняем результат в файл\n",
    "result_bundle = {\n",
    "    \"section_results\": section_results,\n",
    "    \"remarks\": remarks,\n",
    "    \"driver_summary_map\": driver_summary_map,\n",
    "}\n",
    "\n",
    "output_path = Path(\"driver_analysis_results.json\")\n",
    "output_path.write_text(json.dumps(result_bundle, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n",
