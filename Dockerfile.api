FROM ubuntu:24.04

# Системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    libreoffice-core \
    libreoffice-writer \
    poppler-utils \
    curl \
    fonts-liberation \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Проект и .venv монтируются как volumes
# CUDA runtime прокидывается через nvidia-container-toolkit
CMD ["/app/.venv/bin/python", "-m", "uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8080"]
