# Переменные окружения сервиса проверки документов.
# Скопировать в .env (в корне проекта) и заполнить. .env в git не попадает.
# Приоритет: переменная окружения процесса > .env > значение по умолчанию в коде.

# --- Веб-интерфейс: логин/пароль и токен сессии (ОБЯЗАТЕЛЬНЫ, без них сервер не стартует) ---
AUDIT_LOGIN=admin
AUDIT_PASSWORD=
AUDIT_TOKEN=

# --- Модель (OpenAI-совместимый endpoint: vLLM, llama.cpp, Ollama и т.п.) ---
# База URL до /v1/, имя модели, ключ (для локальных серверов — любое непустое значение).
LLM_BASE_URL=http://127.0.0.1:11437/v1/
LLM_MODEL=Qwen3.6-35B-A3B
LLM_API_KEY=none
# LLM_MAX_TOKENS=4096
# LLM_SEED=42
# Таймаут одного запроса к модели, секунд.
# OPENAI_TIMEOUT_SEC=300

# --- OCR / layout для PDF и сканов (нужны только для типов с .pdf в parser_by_ext) ---
OCR_BASE_URL=http://127.0.0.1:11438/v1/
OCR_API_KEY=none
LAYOUT_BASE_URL=http://127.0.0.1:11439

# --- Фронтенд: разрешённые origin для CORS (через запятую) ---
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
