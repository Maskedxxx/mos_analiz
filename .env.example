# Переменные окружения сервиса проверки документов.
# Скопировать в .env (в корне проекта) и заполнить. .env в git не попадает.
# Приоритет: переменная окружения процесса > .env > значение по умолчанию в коде.

# --- Веб-интерфейс: логин/пароль и токен сессии (ОБЯЗАТЕЛЬНЫ, без них сервер не стартует) ---
AUDIT_LOGIN=admin
AUDIT_PASSWORD=
AUDIT_TOKEN=

# --- Модель (OpenAI-совместимый endpoint: vLLM, llama.cpp, Ollama и т.п.) ---
# База URL до /v1/, имя модели, ключ (для локальных серверов — любое непустое значение).
LLM_BASE_URL=http://127.0.0.1:11437/v1/
LLM_MODEL=Qwen3.6-35B-A3B
LLM_API_KEY=none
# LLM_MAX_TOKENS=4096
# Размер контекста модели (токенов): документ больше — отклоняется до вызова с понятным текстом
# LLM_CONTEXT_TOKENS=262144
# LLM_SEED=42
# Таймаут одного запроса к модели, секунд. Худшее ожидание одного аудита = таймаут × 3
# (клиент openai сам повторяет запрос, max_retries=2) × 5 попыток при неполном ответе × 2 слоя правил.
# OPENAI_TIMEOUT_SEC=300

# --- OCR / layout для PDF и сканов (нужны только для типов с .pdf в parser_by_ext) ---
OCR_BASE_URL=http://127.0.0.1:11438/v1/
OCR_API_KEY=none
LAYOUT_BASE_URL=http://127.0.0.1:11439

# --- Хранение: лимиты по объёму в ГБ (0 — не удалять). Проверяются при старте и раз в сутки:
# пока каталог больше лимита — удаляются самые старые сессии целиком (logs_result/<тип>/session_* вместе
# с original/) и самые старые uploads/<id>/. Выполняющиеся сессии не трогаются.
# LOGS_MAX_GB=5
# UPLOADS_MAX_GB=1

# --- Фронтенд: разрешённые origin для CORS (через запятую) ---
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Запуск через scripts/ (необязательно, дефолты ниже) ---
# API_HOST=127.0.0.1      # 0.0.0.0 — если бэкенд должен быть доступен снаружи (Docker, другой хост)
# API_PORT=8081
# UI_PORT=5174
# GEN_PORT=8090            # порт сервиса генерации наружу (только Docker Compose)
# NODE_VERSION=22         # если Node ставится через nvm — версия для `nvm use`
# LOG_DIR=/tmp            # куда пишутся backend.log и frontend.log
