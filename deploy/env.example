# Переменные демо-деплоя МосМониторинг на Spark. Скопировать в deploy/.env, chmod 600 (.env в .gitignore).
# Значения AUDIT_* / LLM_* / OCR_* / LAYOUT_* — те же, что в .env стенда ms-llm-dev.

# --- деплой ---
PORT=8102                    # порт хоста для ui (диапазон демо 8100–8199); api и gen наружу не публикуются
MEM_API=4g                   # LibreOffice + парсинг документов
MEM_GEN=1g
MEM_UI=256m

# --- туннель tuna ---
TUNA_SUBDOMAIN=mosaudit-demo # → https://mosaudit-demo.ru.tuna.am (mosaudit.ru остаётся стенду)
TUNA_TOKEN=                  # поле token из ~/.config/tuna/tuna.yml на Spark
TUNA_EXTRA_ARGS=             # пусто: у сервиса свой логин (AUDIT_LOGIN / AUDIT_PASSWORD)

# --- сервис проверки (см. .env.example в корне репо) ---
AUDIT_LOGIN=admin
AUDIT_PASSWORD=
AUDIT_TOKEN=
LLM_BASE_URL=http://172.16.10.35:11437/v1/   # стенд Влада, доступен со Spark через OpenVPN
LLM_MODEL=Qwen3.6-35B-A3B
LLM_API_KEY=none
OCR_BASE_URL=http://172.16.10.35:11438/v1/
OCR_API_KEY=none
LAYOUT_BASE_URL=http://172.16.10.35:11439
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
